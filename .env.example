NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Optional frontend upload defaults:
# NEXT_PUBLIC_UPLOAD_IMAGE_MAX_SIZE=1600
# NEXT_PUBLIC_UPLOAD_IMAGE_FORMAT=image/webp
# NEXT_PUBLIC_UPLOAD_IMAGE_QUALITY=0.78
# NEXT_PUBLIC_R2_UPLOAD_CONCURRENCY=2

R2_IMAGE_PREFIX=question-images
R2_EXISTING_IMAGE_LIMIT=50
# Required for URL/JSONL import retry state signing. Use a long random value.
# REMOTE_IMPORT_STATE_SECRET=change-me-to-a-long-random-secret
# Optional if serving images from a dedicated public R2/custom domain instead of this Worker:
# R2_PUBLIC_BASE_URL=https://files.example.com
